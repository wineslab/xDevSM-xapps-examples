{
    "name": "traffic-balancer-xapp",
    "version": "0.1.0-dev",
    "APP_NAMESPACE": "ricxapp-j",
    "containers": [
        {
            "name": "traffic-balancer-xapp",
            "image": {
                "registry": "docker.io",
                "name": "angeloferaudo/traffic-balancer-xapp",
                "tag": "0.1.0-dev"
            }
        }
    ],
    "messaging": {
        "ports": [
            {
                "name": "http",
                "container": "traffic-balancer-xapp",
                "port": 8080,
                "description": "http service"
            },
            {
                "name": "rmrroute",
                "container": "traffic-balancer-xapp",
                "port": 4561,
                "description": "rmr route port"
            },
            {
                "name": "rmrdata",
                "container": "traffic-balancer-xapp",
                "port": 4560,
                "rxMessages": ["RIC_SUB_RESP", "RIC_SUB_FAILURE", "RIC_SUB_DEL_RESP", "RIC_INDICATION", "RIC_CONTROL_ACK", "RIC_CONTROL_FAILURE"],
                "txMessages": ["RIC_SUB_REQ", "RIC_SUB_DEL_REQ", "RIC_CONTROL_REQ"],
                "policies": [1],
                "description": "rmr data port for traffic-balancer-xapp"
            },
            {
                "name": "gui",
                "container": "traffic-balancer-xapp",
                "port": 7777,
                "description": "Flask + Socket.IO dashboard (added in GUI pass; reserved here)"
            }
        ]
    },
    "controls": {
        "subscription": {
            "url": "http://service-ricxapp-j-traffic-balancer-xapp-http:8080/",
            "clientEndpoint": "service-ricxapp-j-traffic-balancer-xapp-http"
        }
    }
}
